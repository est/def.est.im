---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordCard from '../components/WordCard.astro';
import MeaningsSection from '../components/MeaningsSection.astro';

export const prerender = false;

const { word } = Astro.params;

// 非法/超长词直接 404 短缓存，不渲染 — 拦截枚举攻击的主要入口
const decodedWord = word ? decodeURIComponent(word) : '';
if (!word || decodedWord.length > 80 || /[^\w\s'\-.\u4e00-\u9fa5]/.test(decodedWord)) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, must-revalidate');
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=300, must-revalidate');
  Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
}

// 查询词库 — 直接读 KV（.dict_json 已清理，不再走静态 JSON 自 fetch）
let wordData = null;
let isHit = false;
const isIllegal = Astro.response.headers.has('Cache-Control');
if (!isIllegal) {
  try {
    // Cloudflare Pages Function 环境：优先 KV，本地开发回退为空
    const kv = (Astro.locals as any)?.runtime?.env?.kv_def;
    if (kv) {
      const kvData = await kv.get(word!, { type: 'json' } as any);
      if (kvData && (kvData as any).MEANINGS?.length) {
        wordData = kvData;
        isHit = true;
      }
    }
  } catch (error) {
    console.log('KV miss for:', word);
  }
}

// 未命中则返回空壳，客户端会走 localStorage → /.dict_json → /.lookup
if (!wordData) {
  wordData = {
    WORD: word,
    IPA: '',
    CONJUGATES: '',
    ETYMOLOGY: '',
    SINCE: '',
    MEANINGS: [],
    REGISTER: ''
  };
}

// 关键：按命中/未命中设置差异化缓存 — 这是降本的核心
if (!Astro.response.headers.has('Cache-Control')) {
  if (isHit) {
    // 真词（8220 词库内）：定义稳定，browser 1h / edge 1d + SWR 1d
    Astro.response.headers.set(
      'Cache-Control',
      'public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400'
    );
    Astro.response.headers.set(
      'CDN-Cache-Control',
      'public, max-age=86400, stale-while-revalidate=86400'
    );
  } else {
    // 未命中词（枚举攻击的随机短语，如 "crazed look"）：短缓存防污染
    // browser 1m / edge 5m，5 分钟内同一随机词只回源 1 次
    Astro.response.status = 404;
    Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, must-revalidate');
    Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=300, must-revalidate');
  }
}
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('Vary', 'Accept-Encoding');
---

<BaseLayout title={`${word} - def.est.im`} word={word} wordData={wordData}>
  <WordCard 
    word={wordData.WORD}
    ipa={wordData.IPA}
    conjugates={wordData.CONJUGATES}
    etymology={wordData.ETYMOLOGY}
    since={wordData.SINCE}
    register={wordData.REGISTER}
  />

  <main class="main">
    <MeaningsSection meanings={wordData.MEANINGS} />

    <section>
      <h2>使用</h2>
      <div style="color:var(--muted);line-height:1.6">
        <p><strong>Register:</strong> <span x-text="REGISTER">{wordData.REGISTER}</span></p>
      </div>
    </section>

    <section>
      <h2>注意</h2>
      <div style="color:var(--muted);line-height:1.6">
        <p>本词典由AI撰写。仅供参考。 <a href="https://github.com/est/def.est.im">Github</a> | <a href="https://blog.est.im/2025/stdout-12">Blog</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
